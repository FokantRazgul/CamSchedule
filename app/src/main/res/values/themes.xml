<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window background matches the ink token so there is no flash before Compose draws. -->
    <color name="ink">#FF0B0D14</color>

    <style name="Theme.CamPlanner" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
